# Hugging Face — clé serveur uniquement (ne jamais exposer côté client)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Provider IA actif : huggingface | mistral (mistral = placeholder futur)
AI_PROVIDER=huggingface

# --- Modèles recommandés (Vercel → Environment Variables) ---
#
# HF_TEXT_MODEL — génération d'exercices (chat JSON)
#   Recommandé : meta-llama/Llama-3.1-8B-Instruct
#
# HF_VISION_MODEL — analyse photo (chat multimodal via Inference Providers)
#   Recommandé : zai-org/GLM-4.5V:novita
#   Alternative : CohereLabs/aya-vision-32b:cohere
#   Éviter : Qwen/Qwen2.5-VL-7B-Instruct:fastest, llava-hf/* (non routables sur router.huggingface.co)
#
# Sans HF_TOKEN → mode secours (exercices et réflexion génériques).

HF_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_VISION_MODEL=zai-org/GLM-4.5V:novita

# Rate limiting (requêtes par fenêtre par IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# CORS — origines autorisées (séparées par virgule)
# Inclure Expo web (8081/8082) + domaine prod mobile + API
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,https://pastek-art.eu,https://www.pastek-art.eu

# Supabase (Auth + Postgres) — service role côté API uniquement
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mistral (LLM premium serveur — si compte connecté avec crédits > 0)
# Les utilisateurs BYOK envoient leur propre clé via headers ; elle n'est JAMAIS stockée.
MISTRAL_API_KEY=
MISTRAL_TEXT_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409

# Optionnel — modèles BYOK par défaut (clés fournies par le client à chaque requête)
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# ANTHROPIC_TEXT_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest

# --- Google Drive ---
# Client OAuth « Application Web » (secret côté API uniquement).
# URI de redirection autorisées (les deux flux) :
#   https://pastek-art.eu/app/premium-cloud          ← local-first (app web)
#   https://api.pastek-art.eu/api/integrations/gdrive ← ancien callback serveur
#   (local : http://localhost:8081/app/premium-cloud et http://localhost:3000/api/integrations/gdrive)
# Le même Client ID doit être dans EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID (build web).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# OneDrive (Microsoft Graph)
# Azure Portal → Inscriptions d'applications → Nouvelle inscription
# - Comptes : personnel Microsoft + scolaire/pro (common)
# - Redirect URI (Web) : https://api.pastek-art.eu/api/integrations/onedrive
# - Certificats et secrets → Nouveau secret client
# - Autorisations API → Microsoft Graph (déléguées) :
#   Files.ReadWrite, offline_access, User.Read
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# URL publique de l'API (callbacks OAuth) — obligatoire en prod
API_PUBLIC_URL=https://api.pastek-art.eu
# Local : http://localhost:3000

# Retour dans l'app après OAuth (le param connected= est forcé côté API)
MOBILE_INTEGRATION_RETURN_URL=https://pastek-art.eu/app/premium-cloud
# Local web : http://localhost:8081/app/premium-cloud

# Chiffrement AES-256-GCM des tokens OAuth (32 octets — hex 64 chars ou base64)
# Obligatoire pour stocker les tokens Drive. Générer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
# Optionnel — secret dédié pour signer le state OAuth (sinon = clé ci-dessus)
# OAUTH_STATE_SECRET=

# Page admin feedback (api.pastek-art.eu/admin/feedback) — mot de passe privé
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_VIEWER_TOKEN=

# Emails transactionnels (alerte lancement) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pastek Art <noreply@pastek-art.eu>
