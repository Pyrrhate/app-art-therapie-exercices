{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pastek-art.eu" }],
      "destination": "https://pastek-art.eu/:path*",
      "statusCode": 308
    },
    { "source": "/fil", "destination": "/app/fil", "permanent": true },
    { "source": "/fil/:id", "destination": "/app/fil/:id", "permanent": true },
    { "source": "/ritual", "destination": "/app/ritual", "permanent": true },
    { "source": "/exercise", "destination": "/app/exercise", "permanent": true },
    { "source": "/reflection", "destination": "/app/reflection", "permanent": true },
    { "source": "/settings", "destination": "/app/settings", "permanent": true },
    { "source": "/privacy", "destination": "/app/privacy", "permanent": true },
    { "source": "/app/maj", "destination": "/maj", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/app/fil/:id",
      "destination": "/app/fil"
    }
  ]
}
