# URL du backend (sans slash final) — utiliser api.pastek-art.eu, PAS pastek-art.eu (site web)
# Défaut si non défini : https://api.pastek-art.eu
# API locale uniquement si vous lancez apps/api en parallèle :
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Production web (Vercel) — variable à définir sur le projet Vercel « web » :
EXPO_PUBLIC_API_URL=https://api.pastek-art.eu

# Google Drive (OAuth client-side, local-first) — même Client ID Web Google Cloud
# que GOOGLE_DRIVE_CLIENT_ID sur l'API (le secret reste uniquement côté API).
# Redirect URI à ajouter dans Google Cloud :
#   https://pastek-art.eu/app/premium-cloud
#   http://localhost:8081/app/premium-cloud
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Page de soutien (Ko-fi, Buy Me a Coffee, Stripe Payment Link…)
# Voir SUPPORT.md
# EXPO_PUBLIC_SUPPORT_URL=https://ko-fi.com/votrepseudo

# Téléphone physique (IP du PC sur le Wi‑Fi) — pour API locale uniquement :
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000

# Supabase — obsolète pour l'auth app (local-first). Peut rester vide.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
