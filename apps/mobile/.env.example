# URL du backend (sans slash final) — utiliser api.pastek-art.eu, PAS pastek-art.eu (site web)
# Dev local :
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Production web (Vercel) — variable à définir sur le projet Vercel « web » :
EXPO_PUBLIC_API_URL=https://api.pastek-art.eu

# Page de soutien (Ko-fi, Buy Me a Coffee, Stripe Payment Link…)
# Voir SUPPORT.md
# EXPO_PUBLIC_SUPPORT_URL=https://ko-fi.com/votrepseudo

# Téléphone physique (IP du PC sur le Wi‑Fi) :
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000

# Supabase (Auth client — anon key uniquement, jamais la service role)
# Option A : définir ici (dev local)
# Option B : laisser vide — l'app récupère la config via GET /api/config/public
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
